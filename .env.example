# ============================================================
# CineLuxe — .env.example
# DevOps / Deployment: Hikmatov Dilshodbek (U2310091)
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to GitHub (it's in .gitignore)
#
# This file is the TEMPLATE for all environment variables
# used across all 12 containers in docker-compose.yml.
# Each service reads its secrets from here at startup.
#
# Categories:
#   - PostgreSQL credentials (primary database)
#   - Redis password (cache + seat locks)
#   - MongoDB credentials (daily reports)
#   - RabbitMQ credentials (booking events)
#   - JWT secret key (API authentication)
#   - Grafana admin password (monitoring dashboard)
# ============================================================

# PostgreSQL
POSTGRES_DB=cinema
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_pass

# Redis
REDIS_PASSWORD=redis_pass

# MongoDB
MONGO_USER=mongo_user
MONGO_PASSWORD=mongo_pass
MONGO_DB=cinema_logs

# RabbitMQ
RABBITMQ_USER=rabbit_user
RABBITMQ_PASSWORD=rabbit_pass
RABBITMQ_VHOST=cinema

# App
SECRET_KEY=change-me-in-production
DEBUG=true
